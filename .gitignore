# =============================================================================
# Root .gitignore — IDS-4-Critical-Infrastructures (J26-CS-318)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Raw & Pre-processed Datasets / Archives (Large files)
# -----------------------------------------------------------------------------
Dataset/
Dataset.zip
Pre-processed/
Pre-processed.zip
*.pcap
*.pcapng
~$*.xlsx
~$*.csv

# -----------------------------------------------------------------------------
# 2. Python Virtual Environments, Caches & Packaging
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -----------------------------------------------------------------------------
# 3. Node.js / React Frontend Dependencies & Build Artifacts
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/dist/
**/frontend/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# -----------------------------------------------------------------------------
# 4. C2 Generated Large Data Copies & Runtime Exports
#    (Keep lightweight JSON metrics, plots, docs, and sample windows tracked)
# -----------------------------------------------------------------------------
C2_Reconnaissance_Detection/data/raw/*.csv
C2_Reconnaissance_Detection/data/processed/*.csv
C2_Reconnaissance_Detection/data/rebuilt_sequences/*.csv
C2_Reconnaissance_Detection/data/rebuilt_sequences/*.npy
C2_Reconnaissance_Detection/artifacts/predictions.csv
C2_Reconnaissance_Detection/artifacts/baseline_oof_predictions.csv
C2_Reconnaissance_Detection/artifacts/lstm_oof_predictions.csv
C2_Reconnaissance_Detection/artifacts/whole_network_packets.bin
C2_Reconnaissance_Detection/artifacts/dashboard_data.json
C2_Reconnaissance_Detection/artifacts/tables/packet_signature_flags.csv
C2_Reconnaissance_Detection/frontend/public/whole_network_packets.bin
C2_Reconnaissance_Detection/frontend/public/dashboard_data.json

# -----------------------------------------------------------------------------
# 5. Environment Variables, Logs, OS & Editor Files
